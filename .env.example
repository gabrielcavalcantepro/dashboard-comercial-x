# Chave de API do Google Cloud restrita à "Google Sheets API".
# Como gerar: console.cloud.google.com -> APIs e Serviços -> Credenciais -> Criar credenciais -> Chave de API
# Depois, em "Restrições de API", limite a chave apenas à Google Sheets API.
GOOGLE_SHEETS_API_KEY=

# Projeto do Supabase (Settings -> API no dashboard do projeto).
# Rode supabase/schema.sql no SQL Editor do projeto antes do primeiro uso.
SUPABASE_URL=
# A "service_role" key, não a "anon" — só é usada no servidor (Server
# Components / Route Handlers), nunca fica exposta ao navegador.
SUPABASE_SERVICE_ROLE_KEY=
